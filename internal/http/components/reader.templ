package components

import "strconv"

// ReaderPage is one page image of the chapter being read. Index is the
// zero-based position in plugin reading order; URL is the host-owned image
// address.
type ReaderPage struct {
	URL   string
	Index int
}

// ReaderChapter is the chapter rendered by the reader: its number label,
// exact plugin chapter id, ordered pages and the previous/next entries as
// both number labels and exact ids.
type ReaderChapter struct {
	Number     float64
	ID         string
	Pages      []ReaderPage
	PrevNumber float64
	NextNumber float64
	PrevID     string
	NextID     string
}

// readerState is the Alpine component behind the reader surface: it owns the
// overlay, the current page, mode/direction/zoom, in-place chapter switching
// against /api/pages with history.pushState/popstate restore, tap zones,
// keyboard navigation and debounced position posts to /reader/position.
const readerState = `{
	overlay: false,
	done: false,
	mode: 'paged',
	direction: 'ltr',
	zoom: 'width',
	ch: 0,
	chId: '',
	pages: [],
	chapters: [],
	prevRef: null,
	nextRef: null,
	pageIdx: 0,
	saveT: null,
	init() {
		const b = JSON.parse(document.getElementById('reader-boot').textContent);
		this.mode = b.mode || 'paged';
		this.direction = b.direction || 'ltr';
		this.zoom = b.zoom || 'width';
		this.ch = b.chapter;
		this.chId = b.chId;
		this.pages = b.pages || [];
		this.chapters = b.chapters || [];
		this.prevRef = b.prev;
		this.nextRef = b.next;
		this.pageIdx = Math.min(Math.max((b.position || 1) - 1, 0), Math.max(this.total - 1, 0));
		this.$nextTick(() => this.scrollToPage());
		this.save(); // nudge the prefetch worker immediately on open
		this.$watch('mode', () => { this.$nextTick(() => this.scrollToPage()); this.save(); });
		this.$watch('direction', () => this.save());
		this.$watch('zoom', () => { this.$refs.stage.scrollTop = 0; this.save(); });
		window.addEventListener('popstate', (ev) => this.onPop(ev));
	},
	get total() { return this.pages.length; },
	get units() {
		const n = this.total;
		if (this.mode !== 'spread-h' && this.mode !== 'spread-v') {
			const u = [];
			for (let i = 0; i < n; i++) u.push([i]);
			return u;
		}
		const u = [];
		let i = 0;
		if (n > 0) { u.push([0]); i = 1; }
		while (i < n) { const p = [i]; if (i + 1 < n) p.push(i + 1); u.push(p); i += 2; }
		return u;
	},
	get unitIdx() {
		const u = this.units;
		for (let i = 0; i < u.length; i++) if (u[i].includes(this.pageIdx)) return i;
		return 0;
	},
	get currentUnit() { return this.units[this.unitIdx] || []; },
	get isWebtoon() { return this.mode === 'webtoon'; },
	get isSpread() { return this.mode === 'spread-h' || this.mode === 'spread-v'; },
	get wrapClass() {
		if (this.zoom === 'width') return 'mx-auto w-full';
		if (this.zoom === 'original') return 'mx-auto w-max max-w-none';
		return 'mx-auto w-full max-w-3xl';
	},
	get stripImgClass() {
		return this.zoom === 'original' ? 'block h-auto' : 'block h-auto w-full';
	},
	get stageImgClass() {
		if (this.zoom === 'width') return 'h-auto w-full max-w-none';
		if (this.zoom === 'original') return 'max-w-none';
		return 'max-h-full max-w-full object-contain';
	},
	routeParts() {
		const seg = location.pathname.split('/');
		return { plugin: seg[2] || '', slug: seg[3] || '' };
	},
	get exitHref() { // the manga's detail page, derived from the /read route
		const r = this.routeParts();
		return '/view/manga/' + r.plugin + '/' + r.slug;
	},
	setPage(i) {
		const n = Math.min(Math.max(i, 0), Math.max(this.total - 1, 0));
		if (n === this.pageIdx) return;
		this.pageIdx = n;
		if (this.isWebtoon) this.scrollToPage();
		this.save();
	},
	jumpTo(ev) {
		const v = parseInt(ev.target.value, 10);
		if (!isNaN(v)) this.setPage(v - 1);
		ev.target.value = this.pageIdx + 1;
	},
	chapterFromSelect(ev) {
		const opt = ev.target.selectedOptions[0];
		if (!opt) return;
		this.switchTo({ ch: parseFloat(opt.dataset.ch || '0'), id: opt.value }, 'first', true);
	},
	next() {
		if (this.isWebtoon) { this.scrollScreen(1); return; }
		const u = this.units, i = this.unitIdx;
		if (i < u.length - 1) { this.setPage(u[i + 1][0]); return; }
		if (this.nextRef && this.nextRef.id) { this.switchTo(this.nextRef, 'first', true); return; }
		this.done = true;
	},
	prev() {
		if (this.isWebtoon) { this.scrollScreen(-1); return; }
		const u = this.units, i = this.unitIdx;
		if (i > 0) { this.setPage(u[i - 1][0]); return; }
		if (this.prevRef && this.prevRef.id) this.switchTo(this.prevRef, 'last', true);
	},
	tapLeft() { this.direction === 'rtl' ? this.next() : this.prev(); },
	tapRight() { this.direction === 'rtl' ? this.prev() : this.next(); },
	scrollScreen(d) {
		this.$refs.stage.scrollBy({ top: d * window.innerHeight * 0.9, behavior: 'smooth' });
	},
	scrollToPage() {
		if (!this.isWebtoon) { this.$refs.stage.scrollTop = 0; return; }
		const im = this.$refs.stage.querySelector('img[data-page="' + this.pageIdx + '"]');
		if (im) im.scrollIntoView();
	},
	onScroll() {
		if (!this.isWebtoon) return;
		const mid = window.innerHeight / 2;
		const imgs = this.$refs.stage.querySelectorAll('img[data-page]');
		for (const im of imgs) {
			if (im.getBoundingClientRect().bottom > mid) {
				const p = parseInt(im.dataset.page, 10);
				if (p !== this.pageIdx) { this.pageIdx = p; this.save(); }
				break;
			}
		}
	},
	onKey(ev) {
		const tag = ev.target && ev.target.tagName;
		if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
		if (ev.key === 'Escape') {
			if (this.done) { this.done = false; return; }
			if (this.overlay) { this.overlay = false; return; }
			if (window.htmx) htmx.ajax('GET', this.exitHref, { target: '#page-main', swap: 'outerHTML', select: '#page-main', pushUrl: true }); else location.href = this.exitHref;
			return;
		}
		switch (ev.key) {
		case 'ArrowLeft': ev.preventDefault(); this.direction === 'rtl' ? this.next() : this.prev(); break;
		case 'ArrowRight': ev.preventDefault(); this.direction === 'rtl' ? this.prev() : this.next(); break;
		case 'ArrowUp': case 'PageUp': ev.preventDefault(); this.prev(); break;
		case 'ArrowDown': case 'PageDown': case ' ': ev.preventDefault(); this.next(); break;
		}
	},
	async switchTo(ref, where, push) {
		if (!ref || !ref.id) return;
		const r = this.routeParts();
		const res = await fetch('/api/pages/' + r.plugin + '/' + r.slug + '/' + ref.ch + '?ch_id=' + encodeURIComponent(ref.id));
		if (!res.ok) return;
		const d = await res.json();
		this.applyChapter(d, ref.id, where);
		this.save();
		if (push) {
			const url = '/read/' + r.plugin + '/' + r.slug + '?ch=' + this.ch + '&ch_id=' + encodeURIComponent(this.chId);
			history.pushState({ ch: this.ch, chId: this.chId, page: this.pageIdx + 1 }, '', url);
		}
	},
	applyChapter(d, id, where) {
		this.ch = d.chapter;
		this.chId = id;
		this.pages = d.pages || [];
		this.prevRef = d.prev_ch_id ? { ch: d.prev_ch, id: d.prev_ch_id } : null;
		this.nextRef = d.next_ch_id ? { ch: d.next_ch, id: d.next_ch_id } : null;
		this.pageIdx = where === 'last' ? Math.max(this.total - 1, 0) : 0;
		this.done = false;
		this.$refs.stage.scrollTop = 0;
	},
	async onPop(ev) {
		const q = new URLSearchParams(location.search);
		const id = q.get('ch_id') || '';
		const ch = parseFloat(q.get('ch') || '0');
		if (id === this.chId) return;
		const r = this.routeParts();
		const res = await fetch('/api/pages/' + r.plugin + '/' + r.slug + '/' + ch + '?ch_id=' + encodeURIComponent(id));
		if (!res.ok) return;
		const d = await res.json();
		this.applyChapter(d, id, 'first');
		if (ev.state && ev.state.page) this.pageIdx = Math.min(Math.max(ev.state.page - 1, 0), Math.max(this.total - 1, 0));
		this.save();
	},
	save() {
		clearTimeout(this.saveT);
		this.saveT = setTimeout(() => {
			const r = this.routeParts();
			fetch('/reader/position', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ plugin: r.plugin, slug: r.slug, chapter: this.ch, chapter_id: this.chId, page: this.pageIdx + 1, mode: this.mode, direction: this.direction, zoom: this.zoom })
			});
		}, 300);
	}
}`

// readerBootstrap returns the initial client state for JSONScript: the
// chapter, its ordered page URLs, exact neighbour ids, persisted mode and
// direction, and the resume page.
func readerBootstrap(mangaName string, chapter ReaderChapter, mode, direction, zoom string, positionPage int, chapters []ChapterOption) map[string]any {
	urls := make([]string, len(chapter.Pages))
	for i, p := range chapter.Pages {
		urls[i] = p.URL
	}
	options := make([]map[string]any, 0, len(chapters))
	for _, c := range chapters {
		options = append(options, map[string]any{"id": c.ID, "number": c.Number, "title": c.Title})
	}
	return map[string]any{
		"manga":     mangaName,
		"mode":      mode,
		"direction": direction,
		"zoom":      zoom,
		"chapter":   chapter.Number,
		"chId":      chapter.ID,
		"pages":     urls,
		"position":  positionPage,
		"prev":      readerNeighbour(chapter.PrevNumber, chapter.PrevID),
		"next":      readerNeighbour(chapter.NextNumber, chapter.NextID),
		"chapters":  options,
	}
}

// readerNeighbour packs one neighbour entry for the bootstrap JSON, or nil
// when the chapter has no neighbour on that side.
func readerNeighbour(number float64, id string) map[string]any {
	if id == "" {
		return nil
	}
	return map[string]any{"ch": number, "id": id}
}

// chLabel formats a chapter number label, dropping a redundant fraction.
func chLabel(n float64) string {
	return strconv.FormatFloat(n, 'f', -1, 64)
}

// Reader renders the full-screen reading surface over the shared shell: page
// images in reading order (vertically scrollable in webtoon mode), an
// overlay hidden by default and toggled by a centre tap with a top bar (back
// to the library, chapter picker, mode/direction/zoom controls) and a bottom
// bar (n / total page jump, keyboard hints), a persistent position indicator
// while the overlay is hidden, and client-side in-place chapter switching.
// ponytail: webtoon resume scroll lands early while lazy images still have no
// height; revisit with explicit aspect ratios when the pages API carries them.
templ Reader(active Page, pages []Page, mangaName string, chapter ReaderChapter, mode, direction, zoom string, positionPage int, chapters []ChapterOption) {
	@Base(active, pages) {
		<div
			x-data={ readerState }
			data-mode={ mode }
			data-direction={ direction }
			x-bind:data-mode="mode"
			x-bind:data-direction="direction"
			x-on:keydown.window="onKey($event)"
			class="fixed inset-0 z-50 flex flex-col overflow-hidden bg-black text-zinc-200 select-none"
		>
			@templ.JSONScript("reader-boot", readerBootstrap(mangaName, chapter, mode, direction, zoom, positionPage, chapters))
			<!-- reading surface -->
			<div x-ref="stage" x-on:scroll.passive="onScroll" class="relative min-h-0 flex-1 overflow-y-auto overscroll-contain">
				<template x-if="total === 0">
					<p class="flex h-full items-center justify-center text-sm text-zinc-500">No pages available for this chapter.</p>
				</template>
				<template x-if="isWebtoon && total > 0">
					<div x-bind:class="wrapClass" class="flex flex-col items-center">
						<template x-for="(u, i) in pages" x-bind:key="chId + '-' + i">
							<img x-bind:src="u" x-bind:data-page="i" x-bind:alt="'Page ' + (i + 1)" loading="lazy" x-bind:class="stripImgClass"/>
						</template>
					</div>
				</template>
				<template x-if="!isWebtoon && total > 0">
					<div class="flex h-full justify-center gap-1 p-2" x-bind:class="{ 'items-center': zoom === 'fit', 'items-start': zoom !== 'fit', 'flex-col': mode === 'spread-v', 'flex-row-reverse': mode === 'spread-h' && direction === 'rtl' }">
						<template x-for="i in currentUnit" x-bind:key="chId + '-' + i">
							<img x-bind:src="pages[i]" x-bind:alt="'Page ' + (i + 1)" x-bind:class="stageImgClass" class="min-w-0"/>
						</template>
					</div>
				</template>
			</div>
			<!-- tap zones: left/centre/right thirds -->
			<div class="pointer-events-none fixed inset-0 z-10 grid grid-cols-3" aria-hidden="false">
				<button type="button" x-on:click="tapLeft" aria-label="Previous page" class="pointer-events-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400"></button>
				<button type="button" x-on:click="overlay = !overlay" aria-label="Toggle reader menu" class="pointer-events-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400"></button>
				<button type="button" x-on:click="tapRight" aria-label="Next page" class="pointer-events-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400"></button>
			</div>
			<!-- persistent position indicator while the nav is hidden -->
			<div x-show="!overlay" class="pointer-events-none fixed bottom-3 left-1/2 z-20 -translate-x-1/2 rounded-full bg-zinc-950/60 px-3 py-1 font-mono text-xs text-zinc-500">
				<span x-text="'p ' + (pageIdx + 1) + ' / ' + total"></span>
			</div>
			<!-- overlay -->
			<div x-show="overlay" x-cloak class="pointer-events-none fixed inset-0 z-30">
				<div class="pointer-events-auto border-b border-zinc-800 bg-zinc-950/90 backdrop-blur">
					<div class="relative flex h-12 items-center justify-center px-4">
						<span class="truncate text-sm font-semibold text-zinc-100">{ mangaName }</span>
						<a x-bind:href="exitHref" x-on:click.prevent="htmx.ajax('GET', exitHref, { target: '#page-main', swap: 'outerHTML', select: '#page-main', pushUrl: true })" class="absolute right-3 rounded-md border border-zinc-700 px-2 py-1 text-xs font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-zinc-100">Back to detail →</a>
					</div>
					<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border-t border-zinc-800/60 px-4 py-2">
						<nav aria-label="Chapter and page" class="flex flex-wrap items-center justify-center gap-1">
							<button type="button" x-on:click="switchTo(prevRef, 'last', true)" x-bind:disabled="!prevRef" class="rounded-md border border-zinc-700 px-2 py-1 font-mono text-xs text-zinc-300 transition hover:border-zinc-500 hover:text-zinc-100 disabled:opacity-40">
								‹ <span x-text="prevRef ? 'ch ' + prevRef.ch : '—'"></span>
							</button>
							<select aria-label="Chapter" x-on:change="chapterFromSelect($event)" class="max-w-56 rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 font-mono text-xs text-zinc-100 focus:border-amber-400 focus:outline-none">
								<template x-for="c in chapters" x-bind:key="c.id">
									<option x-bind:value="c.id" x-bind:data-ch="c.number" x-bind:selected="c.id === chId" x-text="'ch ' + c.number + (c.title ? ' · ' + c.title : '')"></option>
								</template>
							</select>
							<select aria-label="Page" x-on:change="setPage(parseInt($event.target.value, 10) - 1)" class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 font-mono text-xs text-zinc-100 focus:border-amber-400 focus:outline-none">
								<template x-for="i in total" x-bind:key="i">
									<option x-bind:value="i" x-bind:selected="i === pageIdx + 1" x-text="'p ' + i"></option>
								</template>
							</select>
							<button type="button" x-on:click="switchTo(nextRef, 'first', true)" x-bind:disabled="!nextRef" class="rounded-md border border-zinc-700 px-2 py-1 font-mono text-xs text-zinc-300 transition hover:border-zinc-500 hover:text-zinc-100 disabled:opacity-40">
								<span x-text="nextRef ? 'ch ' + nextRef.ch : '—'"></span> ›
							</button>
						</nav>
						<label class="flex items-center gap-2 text-xs text-zinc-400">
							Mode
							<select x-model="mode" aria-label="Reading mode" class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-xs text-zinc-100 focus:border-amber-400 focus:outline-none">
								<option value="webtoon">Webtoon</option>
								<option value="paged">Paged</option>
								<option value="spread-h">Spread →</option>
								<option value="spread-v">Spread ↓</option>
							</select>
						</label>
						<label class="flex items-center gap-2 text-xs text-zinc-400">
							Direction
							<select x-model="direction" aria-label="Reading direction" class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-xs text-zinc-100 focus:border-amber-400 focus:outline-none">
								<option value="ltr">Left to right</option>
								<option value="rtl">Right to left</option>
							</select>
						</label>
						<label class="flex items-center gap-2 text-xs text-zinc-400">
							Zoom
							<select x-model="zoom" aria-label="Zoom" class="rounded-md border border-zinc-700 bg-zinc-900 px-2 py-1 text-xs text-zinc-100 focus:border-amber-400 focus:outline-none">
								<option value="fit">Fit screen</option>
								<option value="width">Fit width</option>
								<option value="original">Original</option>
							</select>
						</label>
					</div>
				</div>
			</div>
			<!-- done overlay: last page of the last chapter -->
			<div x-show="done" x-cloak class="fixed inset-0 z-40 flex items-center justify-center bg-zinc-950/90 backdrop-blur">
				<div class="rounded-xl border border-zinc-800 bg-zinc-900 px-8 py-6 text-center">
					<p class="font-mono text-sm font-semibold text-amber-300">All caught up</p>
					<p class="mt-1 text-sm text-zinc-400">This is the last page of the last chapter.</p>
					<div class="mt-4 flex items-center justify-center gap-2">
						<button type="button" x-on:click="done = false" class="rounded-md border border-zinc-700 px-3 py-1.5 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-zinc-100">Stay</button>
						<a x-bind:href="exitHref" x-on:click.prevent="htmx.ajax('GET', exitHref, { target: '#page-main', swap: 'outerHTML', select: '#page-main', pushUrl: true })" class="rounded-md bg-zinc-100 px-3 py-1.5 text-sm font-semibold text-zinc-900 transition hover:bg-zinc-300">Back to detail</a>
					</div>
				</div>
			</div>
		</div>
	}
}
