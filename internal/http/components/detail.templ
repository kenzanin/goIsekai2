package components

import (
	"strconv"
	"strings"
)

// DetailRow is the saved detail of one manga as rendered by the detail page.
// Plugin and Slug address the row; ChosenCover overrides Cover when set
// (the user-picked candidate); Cached reports that the row was served from
// the store without a plugin call.
type DetailRow struct {
	Plugin      string
	Slug        string
	Name        string
	Cover       string
	Status      string
	Synopsis    string
	Authors     []string
	Tags        []string
	ChosenCover string
	Cached      bool
}

// Candidate is one enrichment match offered to the user. Selected marks the
// candidate the stored choice was built from; nothing is applied until the
// explicit Apply button is pressed.
type Candidate struct {
	ID       string
	Name     string
	Cover    string
	Synopsis string
	Selected bool
}

// Detail renders the manga detail page: cover and per-field metadata with a
// placeholder whenever a field is empty, the normal/force fetch and reset
// actions posting to their dedicated routes, the chapter list with read and
// cbz links, and the enrichment candidates whose cover is applied only on an
// explicit pick.
templ Detail(active Page, pages []Page, row DetailRow, chapters []ChapterRow, candidates []Candidate) {
	@Base(active, pages) {
		<div class="space-y-8">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div class="min-w-0">
					<h1 class="font-mono text-2xl font-semibold tracking-tight text-zinc-50">{ detailOr(row.Name, "Untitled") }</h1>
					<p class="mt-1 flex items-center gap-2 text-sm text-zinc-400">
						<span class="font-mono text-xs uppercase tracking-widest text-zinc-500">{ detailOr(row.Plugin, "no plugin") }</span>
						if row.Cached {
							<span class="rounded bg-amber-400/10 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-widest text-amber-300">cached</span>
						}
					</p>
				</div>
				<div class="flex items-center gap-2">
					<form method="post" action={ templ.SafeURL("/api/refresh/" + row.Plugin + "/" + row.Slug) }>
						<button type="submit" aria-label="Fetch detail and chapters" title="Fetch" class="flex items-center gap-1.5 rounded-md border border-zinc-700 px-3 py-1.5 text-sm font-medium text-zinc-200 transition hover:border-amber-400 hover:text-amber-300">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"></path></svg>
							Fetch
						</button>
					</form>
					<form method="post" action={ templ.SafeURL("/api/refresh/" + row.Plugin + "/" + row.Slug + "/force") }>
						<button type="submit" aria-label="Force refresh, replacing cached detail and chapters" title="Force refresh" class="flex items-center gap-1.5 rounded-md border border-zinc-700 px-3 py-1.5 text-sm font-medium text-zinc-200 transition hover:border-amber-400 hover:text-amber-300">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z"></path></svg>
							Force
						</button>
					</form>
					<form method="post" action={ templ.SafeURL("/api/detail/" + row.Plugin + "/" + row.Slug + "/reset") }>
						<button type="submit" aria-label="Reset detail and cover to the plugin values" title="Reset to plugin data" class="flex items-center gap-1.5 rounded-md border border-zinc-700 px-3 py-1.5 text-sm font-medium text-zinc-400 transition hover:border-zinc-500 hover:text-zinc-100">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"></path></svg>
							Reset
						</button>
					</form>
				</div>
			</div>
			<div class="grid gap-6 sm:grid-cols-[180px_1fr]">
				@detailCover(row)
				<dl class="space-y-3 text-sm">
					<div class="flex gap-2">
						<dt class="w-20 shrink-0 font-mono text-xs uppercase leading-6 tracking-widest text-zinc-500">Status</dt>
						<dd class="text-zinc-200">{ detailOr(row.Status, "Unknown") }</dd>
					</div>
					<div class="flex gap-2">
						<dt class="w-20 shrink-0 font-mono text-xs uppercase leading-6 tracking-widest text-zinc-500">Authors</dt>
						if len(row.Authors) > 0 {
							<dd class="text-zinc-200">{ strings.Join(row.Authors, ", ") }</dd>
						} else {
							<dd class="text-zinc-500">Unknown</dd>
						}
					</div>
					<div class="flex gap-2">
						<dt class="w-20 shrink-0 font-mono text-xs uppercase leading-6 tracking-widest text-zinc-500">Tags</dt>
						if len(row.Tags) > 0 {
							<dd>
								<ul aria-label="Tags" class="flex flex-wrap gap-1">
									for _, t := range row.Tags {
										<li class="rounded bg-zinc-800/70 px-1.5 py-0.5 text-[10px] leading-4 text-zinc-300">{ t }</li>
									}
								</ul>
							</dd>
						} else {
							<dd class="text-zinc-500">None</dd>
						}
					</div>
					<div>
						<dt class="font-mono text-xs uppercase tracking-widest text-zinc-500">Synopsis</dt>
						<dd class="mt-1 leading-relaxed text-zinc-300">{ detailOr(row.Synopsis, "No synopsis yet.") }</dd>
					</div>
				</dl>
			</div>
			<section aria-label="Chapters" class="space-y-3">
				<h2 class="font-mono text-sm font-semibold uppercase tracking-widest text-zinc-400">Chapters</h2>
				if len(chapters) == 0 {
					<div class="rounded-xl border border-dashed border-zinc-700 bg-zinc-900/40 px-6 py-10 text-center">
						<p class="text-sm text-zinc-400">No chapters stored; use Fetch to list them.</p>
					</div>
				} else {
					<ul role="list" class="divide-y divide-zinc-800 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/40">
						for _, ch := range chapters {
							@detailChapterRow(row, ch)
						}
					</ul>
				}
			</section>
			<section aria-label="Enrichment candidates" class="space-y-3">
				<div class="flex items-baseline justify-between gap-4">
					<h2 class="font-mono text-sm font-semibold uppercase tracking-widest text-zinc-400">Enrichment</h2>
					<p class="text-xs text-zinc-500">Nothing is overwritten until you apply a candidate.</p>
				</div>
				if len(candidates) == 0 {
					<div class="rounded-xl border border-dashed border-zinc-700 bg-zinc-900/40 px-6 py-10 text-center">
						<p class="text-sm text-zinc-400">No enrichment candidates stored.</p>
					</div>
				} else {
					<ul role="list" class="grid gap-4 sm:grid-cols-2">
						for _, c := range candidates {
							@candidateCard(row, c)
						}
					</ul>
				}
			</section>
		</div>
	}
}

// detailCover renders the chosen cover when set, else the plugin cover, else
// the initial tile placeholder.
templ detailCover(row DetailRow) {
	<div class="w-44 max-sm:mx-auto sm:w-auto">
		if detailCoverURL(row) != "" {
			<img src={ detailCoverURL(row) } alt={ detailOr(row.Name, "Manga") + " cover" } class="aspect-[2/3] w-full rounded-lg border border-zinc-800 object-cover"/>
		} else {
			<span aria-hidden="true" class="flex aspect-[2/3] w-full items-center justify-center rounded-lg border border-zinc-800 bg-zinc-800/60 font-mono text-3xl font-semibold text-amber-300">
				{ pluginInitial(detailOr(row.Name, "?")) }
			</span>
		}
	</div>
}

// detailChapterRow renders one stored chapter with its read link, title and
// page count, plus the icon-only cbz link. ponytail: cbz builds on demand at
// /cbz; switch to a job link when archive generation becomes async.
templ detailChapterRow(row DetailRow, ch ChapterRow) {
	<li class="flex items-center gap-3 px-4 py-2.5">
		<a href={ templ.SafeURL("/read/" + row.Plugin + "/" + row.Slug + "?ch=" + chLabel(ch.Number) + "&ch_id=" + ch.ID) } aria-label={ "Read chapter " + chLabel(ch.Number) } title="Read" class="flex min-w-0 flex-1 items-baseline gap-3 rounded-md p-1 transition hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 shrink-0 text-zinc-500" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 1 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"></path></svg>
			<span class="shrink-0 font-mono text-xs text-zinc-500">ch { chLabel(ch.Number) }</span>
			if ch.Title != "" {
				<span class="truncate text-sm font-medium text-zinc-100">{ ch.Title }</span>
			} else {
				<span class="truncate text-sm font-medium text-zinc-400">Chapter { chLabel(ch.Number) }</span>
			}
		</a>
		if ch.Pages > 0 {
			<span aria-label="Page count" class="shrink-0 rounded bg-zinc-800/70 px-1.5 py-0.5 font-mono text-[10px] leading-4 text-zinc-400">{ strconv.Itoa(ch.Pages) }p</span>
		}
		<a href={ templ.SafeURL("/cbz/" + row.Plugin + "/" + row.Slug + "?ch=" + chLabel(ch.Number) + "&ch_id=" + ch.ID) } aria-label={ "Download chapter " + chLabel(ch.Number) + " as cbz" } title="Download cbz" class="shrink-0 rounded-md p-1.5 text-zinc-500 transition hover:bg-zinc-800 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0 3-3m-3 3-3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"></path></svg>
		</a>
	</li>
}

// candidateCard renders one enrichment match with its cover, reported title
// and synopsis, a selected marker, and the explicit Apply button posting the
// candidate id to the dedicated apply route.
templ candidateCard(row DetailRow, c Candidate) {
	<li class={ "rounded-xl border bg-zinc-900/40 p-4", templ.KV("border-amber-400/60", c.Selected), templ.KV("border-zinc-800", !c.Selected) }>
		<div class="flex gap-3">
			<div class="w-16 shrink-0">
				if c.Cover != "" {
					<img src={ c.Cover } alt={ detailOr(c.Name, "Candidate") + " cover" } loading="lazy" class="aspect-[2/3] w-full rounded-md border border-zinc-800 object-cover"/>
				} else {
					<span aria-hidden="true" class="flex aspect-[2/3] w-full items-center justify-center rounded-md border border-zinc-800 bg-zinc-800/60 font-mono text-sm font-semibold text-zinc-500">?</span>
				}
			</div>
			<div class="min-w-0 flex-1">
				<div class="flex items-center gap-2">
					<h3 class="truncate text-sm font-semibold text-zinc-100">{ detailOr(c.Name, "Untitled candidate") }</h3>
					if c.Selected {
						<span class="shrink-0 rounded bg-amber-400/10 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-widest text-amber-300">selected</span>
					}
				</div>
				<p class="mt-1 line-clamp-3 text-xs leading-relaxed text-zinc-400">{ detailOr(c.Synopsis, "No synopsis reported.") }</p>
			</div>
		</div>
		<form method="post" action={ templ.SafeURL("/api/detail/" + row.Plugin + "/" + row.Slug + "/apply") } class="mt-3 flex justify-end">
			<input type="hidden" name="candidate" value={ c.ID }/>
			<button type="submit" aria-label={ "Apply candidate " + detailOr(c.Name, c.ID) } class="rounded-md border border-zinc-700 px-3 py-1 text-xs font-medium text-zinc-200 transition hover:border-amber-400 hover:text-amber-300">
				Apply
			</button>
		</form>
	</li>
}

// detailOr returns value when non-empty, else the placeholder.
func detailOr(value, placeholder string) string {
	if value != "" {
		return value
	}
	return placeholder
}

// detailCoverURL returns the user-chosen cover when set, else the plugin cover.
func detailCoverURL(row DetailRow) string {
	if row.ChosenCover != "" {
		return row.ChosenCover
	}
	return row.Cover
}
