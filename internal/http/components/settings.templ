package components

import "strconv"

// Row is one registry knob rendered as an editable or read-only form row.
type Row struct {
	FullKey  string
	Key      string
	Doc      string
	Value    string
	Source   string
	Hint     string
	Disabled bool
	Restart  bool
	Invalid  bool
}

// Group is one ini section with its rows.
type Group struct {
	Section string
	Rows    []Row
}

const settingsFormData = `{
	dirty() {
		const out = {};
		this.$root.querySelectorAll('input[data-key]:not(:disabled)').forEach((el) => {
			if (el.value !== el.dataset.original) out[el.dataset.key] = el.value;
		});
		return out;
	},
	hasDirty() {
		return Object.keys(this.dirty()).length > 0;
	},
	markSaved() {
		this.$root.querySelectorAll('input[data-key]').forEach((el) => {
			el.dataset.original = el.value;
		});
	}
}`

// Settings renders the settings page: one row per registry knob grouped by
// section. Alpine tracks dirty fields, htmx submits only those to POST
// /config and swaps the save status fragment in place.
templ Settings(active Page, pages []Page, groups []Group) {
	@Base(active, pages) {
		<form
			x-data={ settingsFormData }
			x-init="$nextTick(() => $el.querySelectorAll('input[data-key]').forEach((el) => { el.dataset.original = el.value; }))"
			x-on:htmx:config-request="$event.detail.parameters = dirty()"
			x-on:htmx:after-request="if ($event.detail.successful) markSaved()"
			hx-post="/config"
			hx-target="#settings-status"
			hx-swap="innerHTML"
			class="space-y-10"
		>
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<h1 class="font-mono text-2xl font-semibold tracking-tight text-zinc-50">Settings</h1>
					<p class="mt-1 text-sm text-zinc-400">Every knob of the running daemon, grouped by section. Only changed fields are submitted.</p>
				</div>
				<button
					type="submit"
					x-bind:disabled="!hasDirty()"
					class="rounded-md bg-amber-400 px-4 py-2 text-sm font-semibold text-zinc-950 shadow transition hover:bg-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 disabled:cursor-not-allowed disabled:opacity-40"
				>
					Save changes
				</button>
			</div>
			<div id="settings-status" role="status" aria-live="polite"></div>
			for _, g := range groups {
				<fieldset class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/40">
					<legend class="ml-4 rounded-md border border-zinc-700 bg-zinc-900 px-2 py-0.5 font-mono text-xs uppercase tracking-widest text-zinc-400">{ g.Section }</legend>
					<dl class="divide-y divide-zinc-800/70">
						for _, r := range g.Rows {
							@settingsRow(r)
						}
					</dl>
				</fieldset>
			}
		</form>
	}
}

// settingsRow renders a single knob: label, input or read-only value, doc
// text, provenance hint and restart badge.
templ settingsRow(r Row) {
	<div class="grid gap-2 px-6 py-5 sm:grid-cols-[minmax(0,14rem)_1fr] sm:gap-6">
		<div>
			<label for={ fieldID(r.FullKey) } class="font-mono text-sm font-medium text-zinc-100">{ r.Key }</label>
			if r.Restart {
				<span class="mt-1.5 inline-flex items-center gap-1 rounded-full bg-sky-400/10 px-2 py-0.5 text-xs font-medium text-sky-300 ring-1 ring-inset ring-sky-400/20">
					restart required
				</span>
			}
			<p class="mt-1.5 text-xs leading-relaxed text-zinc-500">{ r.Doc }</p>
		</div>
		<div class="min-w-0">
			if r.Disabled {
				<input
					id={ fieldID(r.FullKey) }
					type="text"
					value={ r.Value }
					disabled
					class="w-full cursor-not-allowed rounded-md border border-zinc-800 bg-zinc-900/50 px-3 py-2 font-mono text-sm text-zinc-500"
				/>
				<p class="mt-1.5 text-xs text-zinc-500">{ r.Hint } — edit it at that source; this row is read-only.</p>
			} else {
				<input
					id={ fieldID(r.FullKey) }
					type="text"
					data-key={ r.FullKey }
					value={ r.Value }
					if r.Invalid {
						aria-invalid="true"
						class="w-full rounded-md border border-red-500/60 bg-zinc-900 px-3 py-2 font-mono text-sm text-zinc-100 transition focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
					} else {
						class="w-full rounded-md border border-zinc-700 bg-zinc-900 px-3 py-2 font-mono text-sm text-zinc-100 transition focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
					}
				/>
				if r.Invalid {
					<p class="mt-1.5 text-xs font-medium text-red-400">Stored value could not be parsed; showing the default. Fix and save to repair it.</p>
				}
			}
			<p class="mt-1.5 text-xs text-zinc-600">source: { r.Source }</p>
		</div>
	</div>
}

// fieldID derives a stable element id from a section.key full key.
func fieldID(fullKey string) string {
	return "field-" + fullKey
}

// StatusFragment is the htmx response swapped into #settings-status after a
// save attempt: success with the write count, or the validation error.
templ StatusFragment(ok bool, written int, errMsg string) {
	if ok {
		<div class="flex items-center gap-3 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300">
			<span class="font-medium">Saved { strconv.Itoa(written) } { pluralize(written) }.</span>
			<span class="text-emerald-400/70">Live knobs applied; rows marked restart take effect on next boot.</span>
		</div>
	} else {
		<div class="rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
			<span class="font-medium">Save rejected:</span> { errMsg }
		</div>
	}
}

// pluralize returns the singular or plural noun for a written count.
func pluralize(n int) string {
	if n == 1 {
		return "change"
	}
	return "changes"
}
