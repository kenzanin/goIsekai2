package components

import "strings"

// PluginRow is one installed plugin rendered as a row on the plugins page.
type PluginRow struct {
	ID           string
	Name         string
	Version      string
	Runtime      string
	Capabilities []string
	TitleCount   int
	Status       string
	Error        string
	Enabled      bool
	HasLogo      bool
}

const pluginsFilterData = `{
	query: '',
	matches(el) {
		const q = this.query.trim().toLowerCase();
		if (q === '') return true;
		return el.dataset.name.includes(q) || el.dataset.caps.includes(q);
	}
}`

// isEnrichmentPlugin reports whether the row declares the enrichment
// capability — the same rule internal/detail applies when loading enrichment
// sources. Those rows render under the Enrichment heading, the rest under
// Manga plugins.
func isEnrichmentPlugin(r PluginRow) bool {
	for _, c := range r.Capabilities {
		if strings.EqualFold(c, "enrichment") {
			return true
		}
	}
	return false
}

// pluginSection is one titled list on the plugins page.
type pluginSection struct {
	Title string
	Rows  []PluginRow
}

// pluginSections splits rows into the enrichment and manga lists, mirroring
// the detail loader's capability rule; empty sections are omitted.
func pluginSections(rows []PluginRow) []pluginSection {
	enrichment := make([]PluginRow, 0)
	manga := make([]PluginRow, 0)
	for _, r := range rows {
		if isEnrichmentPlugin(r) {
			enrichment = append(enrichment, r)
		} else {
			manga = append(manga, r)
		}
	}
	out := make([]pluginSection, 0, 2)
	if len(enrichment) > 0 {
		out = append(out, pluginSection{Title: "Enrichment", Rows: enrichment})
	}
	if len(manga) > 0 {
		out = append(out, pluginSection{Title: "Manga plugins", Rows: manga})
	}
	return out
}

// Plugins renders the plugins page: the filter input above two separate
// lists — enrichment sources, then manga plugins. Each row carries logo or
// initial, name, version, runtime, capability chips, the status region and
// the toggle/reload actions. Alpine filters rows by name or capability; htmx
// posts toggle/reload and swaps the per-row status region.
templ Plugins(active Page, pages []Page, rows []PluginRow, pluginsDir string) {
	@Base(active, pages) {
		if len(rows) == 0 {
			@pluginsEmptyState(pluginsDir)
		} else {
			<div x-data={ pluginsFilterData } class="space-y-6">
				<input
					id="plugin-q"
					type="search"
					x-model.debounce.150ms="query"
					placeholder="Filter by name or capability…"
					aria-label="Filter plugins"
					class="w-72 rounded border border-zinc-700 bg-zinc-900 px-3 py-1.5 text-sm text-zinc-100 placeholder-zinc-500 transition focus:border-transparent focus:ring-2 focus:ring-zinc-500 focus:outline-none"
				/>
				<p x-show="query.trim() !== ''" class="text-xs text-zinc-600">Filtering by name or capability — clear the field to show all plugins.</p>
				for _, group := range pluginSections(rows) {
					<section>
						<h2 class="mb-2 text-lg font-semibold text-zinc-100">{ group.Title }</h2>
						<ul role="list" class="space-y-2">
							for _, r := range group.Rows {
								@pluginRow(r)
							}
						</ul>
					</section>
				}
			</div>
		}
	}
}

// pluginRowClass dims disabled rows via opacity.
func pluginRowClass(enabled bool) string {
	if enabled {
		return "flex items-center gap-3 rounded-lg border border-zinc-800 bg-zinc-900/40 p-3"
	}
	return "flex items-center gap-3 rounded-lg border border-zinc-800 bg-zinc-900/40 p-3 opacity-50"
}

// pluginRow renders a single plugin: logo or initial, identity, capability
// chips, status region and the toggle/reload actions. Disabled rows dim.
templ pluginRow(r PluginRow) {
	<li
		x-show="matches($el)"
		data-name={ strings.ToLower(r.Name + " " + r.ID) }
		data-caps={ strings.ToLower(strings.Join(r.Capabilities, " ")) }
		class={ pluginRowClass(r.Enabled) }
	>
		if r.HasLogo {
			<img src={ "/plugins/" + r.ID + "/logo" } alt={ r.Name + " logo" } loading="lazy" class="h-9 w-9 shrink-0 rounded bg-zinc-800 object-cover" onerror="this.style.visibility='hidden'"/>
		} else {
			<span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded bg-zinc-800 font-bold text-zinc-300">{ pluginInitial(r.Name) }</span>
		}
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-2">
				<a href={ templ.SafeURL("/library?plugin=" + r.ID) } hx-get={ "/library?plugin=" + r.ID } hx-select="#page-main" hx-target="#page-main" hx-swap="outerHTML" hx-push-url="true" class="font-medium text-zinc-100 transition hover:text-amber-300">{ r.Name }</a>
				<span class="text-xs text-zinc-500">{ r.Version }</span>
				if r.Runtime != "" {
					<span class="rounded bg-zinc-800 px-1.5 py-0.5 text-[10px] uppercase tracking-wide text-zinc-400">{ r.Runtime }</span>
				}
			</div>
			if len(r.Capabilities) > 0 {
				<div class="mt-1 flex flex-wrap gap-1">
					for _, c := range r.Capabilities {
						<span class="rounded border border-zinc-800 bg-zinc-900 px-1.5 py-0.5 text-[10px] text-zinc-400">{ c }</span>
					}
				</div>
			}
			<div class="mt-1">
				<div id={ "plugin-status-" + r.ID } role="status" aria-live="polite" class="inline-flex">
					@PluginStatusFragment(r)
				</div>
			</div>
		</div>
		<span class="flex-1"></span>
		<div class="flex shrink-0 items-center gap-2">
			<button
				type="button"
				hx-post={ "/plugins/" + r.ID + "/toggle" }
				hx-target={ "#plugin-status-" + r.ID }
				hx-swap="innerHTML"
				hx-disabled-elt="this"
				class="rounded bg-zinc-800 px-3 py-1 text-xs text-zinc-100 transition-colors hover:bg-zinc-700 focus-visible:ring-2 focus-visible:ring-zinc-500 focus-visible:outline-none disabled:opacity-40"
			>
				if r.Enabled {
					Disable
				} else {
					Enable
				}
			</button>
			<button
				type="button"
				title="Rescan plugin dir"
				hx-post={ "/plugins/" + r.ID + "/reload" }
				hx-target={ "#plugin-status-" + r.ID }
				hx-swap="innerHTML"
				hx-disabled-elt="this"
				class="rounded bg-zinc-800 px-2 py-1 text-xs text-zinc-100 transition-colors hover:bg-zinc-700 focus-visible:ring-2 focus-visible:ring-zinc-500 focus-visible:outline-none disabled:opacity-40"
			>
				⟳
			</button>
		</div>
	</li>
}

// PluginStatusFragment is the htmx response swapped into the per-row status
// region after a toggle or reload: the status badge plus the error message
// when the plugin is in an error state.
templ PluginStatusFragment(r PluginRow) {
	<div class="flex flex-wrap items-center gap-2">
		<span class={ "rounded px-2 py-0.5 text-xs font-medium ring-1 ring-inset", statusClasses(r.Status) }>
			{ r.Status }
		</span>
		if r.Error != "" {
			<span class="text-xs text-red-400">{ r.Error }</span>
		}
	</div>
}

// pluginsEmptyState replaces both lists when no plugin is installed: it shows
// the scanned directory and the folder layout the daemon expects.
templ pluginsEmptyState(pluginsDir string) {
	<div class="rounded-xl border border-dashed border-zinc-700 bg-zinc-900/40 px-6 py-10 text-center">
		<h2 class="text-sm font-semibold text-zinc-100">No plugins installed</h2>
		<p class="mt-2 text-sm text-zinc-400">
			Drop one folder per site into
			<code class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-xs text-zinc-300">{ pluginsDir }</code>
			and reload the daemon.
		</p>
		<pre class="mx-auto mt-6 inline-block rounded-lg border border-zinc-800 bg-zinc-950 px-5 py-4 text-left font-mono text-xs leading-relaxed text-zinc-400">{ expectedLayout(pluginsDir) }</pre>
	</div>
}

// expectedLayout renders the expected per-plugin folder layout for the empty
// state.
func expectedLayout(pluginsDir string) string {
	return pluginsDir + "/\n" +
		"└── <plugin-id>/\n" +
		"    ├── plugin.lua   # or plugin.js / plugin.wasm\n" +
		"    └── logo.png     # optional"
}

// statusClasses maps a plugin status vocabulary word to badge colors.
func statusClasses(status string) string {
	switch status {
	case "active":
		return "bg-emerald-500/10 text-emerald-300 ring-emerald-500/30"
	case "error", "failed":
		return "bg-red-500/10 text-red-300 ring-red-500/30"
	default:
		return "bg-zinc-500/10 text-zinc-400 ring-zinc-500/30"
	}
}

// pluginInitial returns the uppercase first letter of a plugin name for the
// logo fallback tile.
func pluginInitial(name string) string {
	if name == "" {
		return "?"
	}
	return strings.ToUpper(name[:1])
}
