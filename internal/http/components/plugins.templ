package components

import (
	"strconv"
	"strings"
)

// PluginRow is one installed plugin rendered as a row on the plugins page.
type PluginRow struct {
	ID           string
	Name         string
	Version      string
	Runtime      string
	Capabilities []string
	TitleCount   int
	Status       string
	Error        string
	Enabled      bool
	HasLogo      bool
}

const pluginsFilterData = `{
	query: '',
	matches(el) {
		const q = this.query.trim().toLowerCase();
		if (q === '') return true;
		return el.dataset.name.includes(q) || el.dataset.caps.includes(q);
	}
}`

// Plugins renders the plugins page: one row per installed plugin with status,
// capabilities and actions. Alpine filters rows client-side by name or
// capability; htmx posts toggle/reload and swaps the per-row status region.
templ Plugins(active Page, pages []Page, rows []PluginRow, pluginsDir string) {
	@Base(active, pages) {
		<div class="space-y-8">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<h1 class="font-mono text-2xl font-semibold tracking-tight text-zinc-50">Plugins</h1>
					<p class="mt-1 text-sm text-zinc-400">One plugin per site. Toggle or reload without restarting the daemon.</p>
				</div>
				if len(rows) > 0 {
					<p class="font-mono text-xs uppercase tracking-widest text-zinc-500">{ strconv.Itoa(len(rows)) } installed</p>
				}
			</div>
			if len(rows) == 0 {
				@pluginsEmptyState(pluginsDir)
			} else {
				<div x-data={ pluginsFilterData } class="space-y-4">
					<input
						type="search"
						x-model.debounce.150ms="query"
						placeholder="Filter by name or capability…"
						aria-label="Filter plugins"
						class="w-full rounded-md border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm text-zinc-100 placeholder-zinc-600 transition focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400"
					/>
					<ul role="list" class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/40 divide-y divide-zinc-800/70">
						for _, r := range rows {
							@pluginRow(r)
						}
					</ul>
					<p x-show="query.trim() !== ''" class="text-xs text-zinc-600">Filtering by name or capability — clear the field to show all plugins.</p>
				</div>
			}
		</div>
	}
}

// pluginRow renders a single plugin: logo or initial, identity, capability
// chips, title-count deep link, status region and toggle/reload actions.
templ pluginRow(r PluginRow) {
	<li
		x-show="matches($el)"
		data-name={ strings.ToLower(r.Name + " " + r.ID) }
		data-caps={ strings.ToLower(strings.Join(r.Capabilities, " ")) }
		class="grid gap-4 px-6 py-5 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-start sm:gap-6"
	>
		if r.HasLogo {
			<img src={ "/plugins/" + r.ID + "/logo" } alt={ r.Name + " logo" } class="h-10 w-10 rounded-lg border border-zinc-800 object-cover"/>
		} else {
			<span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-800 bg-zinc-800/60 font-mono text-sm font-semibold text-amber-300">{ pluginInitial(r.Name) }</span>
		}
		<div class="min-w-0 space-y-2">
			<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
				<h2 class="text-sm font-semibold text-zinc-50">{ r.Name }</h2>
				<span class="font-mono text-xs text-zinc-500">v{ r.Version }</span>
				<span class="rounded-full bg-sky-400/10 px-2 py-0.5 text-xs font-medium text-sky-300 ring-1 ring-inset ring-sky-400/20">{ r.Runtime }</span>
			</div>
			if len(r.Capabilities) > 0 {
				<ul role="list" aria-label="Capabilities" class="flex flex-wrap gap-1.5">
					for _, c := range r.Capabilities {
						<li class="rounded-md bg-zinc-800/70 px-1.5 py-0.5 font-mono text-xs text-zinc-400">{ c }</li>
					}
				</ul>
			}
			<div id={ "plugin-status-" + r.ID } role="status" aria-live="polite">
				@PluginStatusFragment(r)
			</div>
		</div>
		<div class="flex shrink-0 items-center gap-2 sm:flex-col sm:items-end">
			<a href={ templ.SafeURL("/library?plugin=" + r.ID) } class="rounded-md px-3 py-1.5 text-sm font-medium text-zinc-400 transition-colors hover:bg-zinc-800 hover:text-zinc-100">
				{ strconv.Itoa(r.TitleCount) } titles
			</a>
			<button
				type="button"
				hx-post={ "/plugins/" + r.ID + "/toggle" }
				hx-target={ "#plugin-status-" + r.ID }
				hx-swap="innerHTML"
				hx-disabled-elt="this"
				class="rounded-md border border-zinc-700 px-3 py-1.5 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 disabled:opacity-40"
			>
				if r.Enabled {
					Disable
				} else {
					Enable
				}
			</button>
			<button
				type="button"
				hx-post={ "/plugins/" + r.ID + "/reload" }
				hx-target={ "#plugin-status-" + r.ID }
				hx-swap="innerHTML"
				hx-disabled-elt="this"
				class="rounded-md border border-amber-400/30 bg-amber-400/10 px-3 py-1.5 text-sm font-medium text-amber-300 transition hover:bg-amber-400/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 disabled:opacity-40"
			>
				Reload
			</button>
		</div>
	</li>
}

// PluginStatusFragment is the htmx response swapped into the per-row status
// region after a toggle or reload: the status badge plus the error message
// when the plugin is in an error state.
templ PluginStatusFragment(r PluginRow) {
	<div class="flex flex-wrap items-center gap-2">
		<span class={ "rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset", statusClasses(r.Status) }>
			{ r.Status }
		</span>
		if r.Error != "" {
			<span class="text-xs text-red-400">{ r.Error }</span>
		}
	</div>
}

// pluginsEmptyState replaces the table when no plugin is installed: it shows
// the scanned directory and the folder layout the daemon expects.
templ pluginsEmptyState(pluginsDir string) {
	<div class="rounded-xl border border-dashed border-zinc-700 bg-zinc-900/40 px-6 py-10 text-center">
		<h2 class="font-mono text-sm font-semibold text-zinc-100">No plugins installed</h2>
		<p class="mt-2 text-sm text-zinc-400">
			Drop one folder per site into
			<code class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-xs text-amber-300">{ pluginsDir }</code>
			and reload the daemon.
		</p>
		<pre class="mx-auto mt-6 inline-block rounded-lg border border-zinc-800 bg-zinc-950 px-5 py-4 text-left font-mono text-xs leading-relaxed text-zinc-400">{ expectedLayout(pluginsDir) }</pre>
	</div>
}

// expectedLayout renders the expected per-plugin folder layout for the empty
// state.
func expectedLayout(pluginsDir string) string {
	return pluginsDir + "/\n" +
		"└── <plugin-id>/\n" +
		"    ├── plugin.lua   # or plugin.js / plugin.wasm\n" +
		"    └── logo.png     # optional"
}

// statusClasses maps a plugin status vocabulary word to badge colors.
func statusClasses(status string) string {
	switch status {
	case "active":
		return "bg-emerald-500/10 text-emerald-300 ring-emerald-500/30"
	case "error", "failed":
		return "bg-red-500/10 text-red-300 ring-red-500/30"
	default:
		return "bg-zinc-500/10 text-zinc-400 ring-zinc-500/30"
	}
}

// pluginInitial returns the uppercase first letter of a plugin name for the
// logo fallback tile.
func pluginInitial(name string) string {
	if name == "" {
		return "?"
	}
	return strings.ToUpper(name[:1])
}
