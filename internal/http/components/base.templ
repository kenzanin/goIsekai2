// Package components holds the templ-rendered UI components of the HTTP pages.
package components

// Page is one implemented page shown in the top navigation.
type Page struct {
	Path  string
	Title string
}

// Base renders the shared HTML shell: head, compiled stylesheet, vendored
// scripts and the top navigation listing exactly the implemented pages.
templ Base(active Page, pages []Page) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ active.Title } · goisekai2</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script defer src="/assets/vendor/htmx.min.js"></script>
			<script defer src="/assets/vendor/alpine.min.js"></script>
		</head>
		<body class="min-h-full bg-zinc-950 font-sans text-zinc-200 antialiased">
			<header class="border-b border-zinc-800 bg-zinc-900/60">
				<div class="mx-auto flex h-14 max-w-4xl items-center gap-8 px-6">
					<span class="font-mono text-sm font-semibold tracking-widest text-amber-400">goisekai2</span>
					<nav aria-label="Primary" class="flex items-center gap-1">
						for _, p := range pages {
							if p.Path == active.Path {
								<a href={ templ.SafeURL(p.Path) } aria-current="page" class="rounded-md bg-amber-400/10 px-3 py-1.5 text-sm font-medium text-amber-300">{ p.Title }</a>
							} else {
								<a href={ templ.SafeURL(p.Path) } class="rounded-md px-3 py-1.5 text-sm font-medium text-zinc-400 transition-colors hover:bg-zinc-800 hover:text-zinc-100">{ p.Title }</a>
							}
						}
					</nav>
				</div>
			</header>
			<main class="mx-auto max-w-4xl px-6 py-10">
				{ children... }
			</main>
		</body>
	</html>
}
