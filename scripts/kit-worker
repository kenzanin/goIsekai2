#!/usr/bin/env bash
# goIsekai2 KIT worker. Every lane runs in its OWN herdr tab: this script creates
# the tab, starts KIT inside it, waits for the lane to finish and prints the tail.
#
# Usage:  ./scripts/kit-worker "<prompt>"
#         ./scripts/kit-worker --continue "<follow-up>"   # resume the last session
#         ./scripts/kit-worker --json "<prompt>" | jq .
# Key:    OMNIROUTE_API_KEY, or the 9router key from ~/.config/opencode/opencode.json.
# Escape: KIT_ALLOW_HEADLESS=1 runs KIT in this terminal when herdr is unavailable.
#
# Environment: KIT_BIN, KIT_PROVIDER_URL, KIT_MODEL (default openai/free), KIT_FALLBACK_MODEL
# (default openai/gemini-3.5-flash-lite), KIT_MAX_STEPS, KIT_WAIT_MS (lane timeout, default 30 min).
# KIT_JEV=1 adds the local jev/systemone MCP tool (opt-in; adds tool schemas to the lane prompt).
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
KIT_BIN="${KIT_BIN:-$HOME/.local/bin/kit}"

resolve_key() {
  if [ -n "${OMNIROUTE_API_KEY:-}" ]; then
    printf '%s' "$OMNIROUTE_API_KEY"
    return
  fi
  python3 - <<'PY' 2>/dev/null || true
import json, os, re
p = os.path.expanduser("~/.config/opencode/opencode.json")
raw = re.sub(r",(\s*[}\]])", r"\1", open(p).read())  # tolerate trailing commas
print(json.loads(raw)["providers"]["9router"]["settings"]["apiKey"])
PY
}

run_kit() {
  local key prompt="" args=() out rc fallback
  key="$(resolve_key)"
  [ -n "$key" ] || { echo "kit-worker: set OMNIROUTE_API_KEY to the local router key" >&2; exit 78; }
  if [ -n "${KIT_PROMPT_FILE:-}" ]; then prompt="$(cat "$KIT_PROMPT_FILE")"; fi
  prompt="$prompt

OKF DUTY (mandatory, after the code work, before you finish): persist what you verified to this
repo's okf knowledge bundle with the okf MCP tools (or the \`okf\` CLI when MCP is unavailable).
- okf_search first to avoid duplicates; okf_update over okf_create when a concept already covers it.
- At most 3 concepts, one fact or decision each. type: \"Fact\" for behaviour you proved by running
  something, \"Decision\" only when you actually chose between alternatives. concept_id: notes/<slug>.
  tags: the package or file it belongs to. description: one sentence. body: the evidence (command
  plus output) and the consequence for our code.
- Record only verified findings, never guesses, never a restatement of the brief.
- Then run \`okf validate knowledge --strict --drift\` and report every concept id you wrote."
  if [ "${KIT_JEV:-0}" = "1" ]; then
    jev_bin="${JEV_MCP_BIN:-$HOME/.config/opencode/vendor/jev-mcp/dist/index.js}"
    [ -f "$jev_bin" ] || { echo "kit-worker: JEV_MCP_BIN missing: $jev_bin" >&2; exit 78; }
    router="${KIT_PROVIDER_URL:-http://localhost:20128/v1}"
    export JEV_API_KEY="$key"
    export JEV_BASE_URL="${JEV_BASE_URL:-${router%/v1}}"
    export JEV_MODEL="${JEV_MODEL:-oc/jev-1.13-free}"
    export JEV_TIMEOUT_MS="${JEV_TIMEOUT_MS:-60000}"
    args+=(--mcp "jev=$(command -v node) $jev_bin")
    prompt="$prompt

JEV TOOL: jev.classify is available. Schema: {texts: string[], instructions: string,
options?: {label: description}}. Use it for classification decisions and report the chosen
label with its confidence."
  fi
  [ -n "${KIT_MODE:-}" ] && args+=("$KIT_MODE")
  [ -n "${KIT_JSON:-}" ] && args+=(--json)
  fallback="${KIT_FALLBACK_MODEL:-openai/gemini-3.5-flash-lite}"
  cd "$REPO"
  # Lean profile: no AGENTS.md/skills/agent catalogs in the system prompt; the brief carries every
  # rule the lane needs. `openai/free` is a combo that routes each request to a random upstream, and
  # some of those upstreams answer with nothing, so an empty answer is retried on a pinned model.
  lane() {
    "$KIT_BIN" --no-daemon \
      --model "$1" --max-steps "${KIT_MAX_STEPS:-30}" \
      --provider-url "${KIT_PROVIDER_URL:-http://localhost:20128/v1}" \
      --provider-wire "${KIT_PROVIDER_WIRE:-openai-compat}" \
      --provider-api-key "$key" \
      "${args[@]+"${args[@]}"}" "$prompt"
  }
  rc=0
  out="$(lane "${KIT_MODEL:-openai/free}" 2>&1)" || rc=$?
  if [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ] && [ "$rc" -eq 0 ] && [ "${KIT_MODEL:-openai/free}" != "$fallback" ]; then
    echo "kit-worker: ${KIT_MODEL:-openai/free} answered nothing; retrying on $fallback" >&2
    rc=0
    out="$(lane "$fallback" 2>&1)" || rc=$?
  fi
  printf '%s\n' "$out"
  return "$rc"
}

# Inner mode: herdr already put us in the lane's tab.
if [ "${KIT_LANE:-}" = "1" ]; then
  rc=0
  run_kit || rc=$?
  echo "__KIT_EXIT=$rc"
  exit "$rc"
fi

prompt="" mode="" json=""
for arg in "$@"; do
  case "$arg" in
    --continue|--resume) mode="$arg" ;;
    --json) json="1" ;;
    *) prompt="$arg" ;;
  esac
done

if [ "${HERDR_ENV:-}" != "1" ]; then
  if [ "${KIT_ALLOW_HEADLESS:-}" = "1" ]; then
    KIT_MODE="$mode" KIT_JSON="$json" run_kit
    exit $?
  fi
  echo "kit-worker: lanes must run in a herdr tab (HERDR_ENV=1). Set KIT_ALLOW_HEADLESS=1 to override." >&2
  exit 64
fi

tmpdir="${TMPDIR:-/tmp/opencode}"
mkdir -p "$tmpdir"
prompt_file="$(mktemp "$tmpdir/kit-lane-XXXXXX")"
printf '%s' "$prompt" >"$prompt_file"
trap 'rm -f "$prompt_file"' EXIT

label="kit:$(printf '%s' "$prompt" | tr -s ' \n\t' ' ' | cut -c1-24)"
tab_json="$(herdr tab create --workspace "${HERDR_WORKSPACE_ID:-}" --label "$label" --no-focus)"
pane="$(printf '%s' "$tab_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')"
tab="$(printf '%s' "$tab_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["tab"]["tab_id"])')"
echo "kit-worker: lane tab $tab pane $pane (label $label)" >&2

sleep 1
herdr pane report-agent "$pane" --source kit-worker --agent kit --state working >/dev/null 2>&1 || true
herdr pane run "$pane" "cd '$REPO' && KIT_LANE=1 KIT_PROMPT_FILE='$prompt_file' KIT_MODE='$mode' KIT_JSON='$json' ./scripts/kit-worker" >/dev/null

herdr pane wait-output "$pane" --match "__KIT_EXIT=" --timeout "${KIT_WAIT_MS:-1800000}" >/dev/null 2>&1 || true
out="$(herdr pane read "$pane" --source recent-unwrapped --lines 200)"
printf '%s\n' "$out"
herdr pane report-agent "$pane" --source kit-worker --agent kit --state idle >/dev/null 2>&1 || true

rc="$(printf '%s' "$out" | grep -o '__KIT_EXIT=[0-9]*' | tail -1 | cut -d= -f2)"
if [ -z "$rc" ]; then
  echo "kit-worker: lane did not report completion within ${KIT_WAIT_MS:-1800000}ms; inspect tab $tab" >&2
  exit 1
fi
exit "$rc"
